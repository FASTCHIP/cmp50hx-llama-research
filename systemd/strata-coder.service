[Unit]
Description=Strata Qwen3.8-Flash-Next Coder (4x CMP50HX, layer split)
After=network.target

[Service]
Type=simple
User=fastchip
WorkingDirectory=/mnt/usbsata/strata
Environment=STRATA_ARENA_MMAP=1
Environment=STRATA_BF16_TC=1
Environment=STRATA_STAGE_TRIM=1
ExecStart=/mnt/usbsata/strata/.venv/bin/python serve/server.py --engine strata --config /mnt/usbsata/strata/strata-coder.json --port 8080
Restart=on-failure
RestartSec=10
LimitMEMLOCK=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
