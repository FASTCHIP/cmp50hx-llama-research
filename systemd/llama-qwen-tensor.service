# Профиль «tensor» для CMP50HX (3× CMP 50HX, TU102, sm_75) — форк verybigbadboy/llama.cpp.
#
# ЕДИНСТВЕННОЕ отличие от llama-qwen.service: --split-mode tensor вместо layer.
# Замеры кампании cont9 (промпт 32K, KV q8_0, ОДИН клиент, 3 GPU):
#   layer  : decode 20.76 tok/s, prefill 495.16 tok/s   <- эталон llama-qwen.service
#   tensor : decode 32.92 tok/s (+58.5%), prefill 498.07 tok/s   <- этот юнит
# На длинном контексте выигрыш ещё больше (192K: +87.7% decode, +26.4% prefill).
#
# ПОЧЕМУ НЕ ВКЛЮЧЁН ПО УМОЛЧАНИЮ: при 5 одновременных клиентах tensor проигрывает
# layer 33.5% (36.18 против 54.42 tok/s) — tensor насыщается, layer растёт.
# Форма этого юнита — --parallel 5, то есть многопользовательский сервис, где
# выигрывает именно layer. Переключать только если нагрузка одиночная/длинный контекст.
#
# Перед применением обязателен гейт качества (PPL): апстрим запрещает сочетание
# tensor + квантованный KV, а форк работает именно так (q8_0). См.
# summaries/FINAL-RESULTS-2026-09-23.md, раздел 2.
#
# Переключение на стенде 192.168.50.9 (с откатом):
#   sudo cp systemd/llama-qwen-tensor.service /etc/systemd/system/
#   sudo systemctl disable --now llama-qwen.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now llama-qwen-tensor.service
# Откат:
#   sudo systemctl disable --now llama-qwen-tensor.service
#   sudo systemctl enable --now llama-qwen.service
#
[Unit]
Description=Qwen3.8 llama.cpp inference server (verybigbadboy fork, tensor profile)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=fastchip
Group=fastchip
WorkingDirectory=/home/fastchip/llama.cpp-vbbb-b7d4d85-sm75/bin
Environment=CUDA_VISIBLE_DEVICES=0,1,2
Environment=GGML_CUDA_GRAPH_OPT=1
Environment=NCCL_P2P_DISABLE=0
Environment=NCCL_P2P_LEVEL=PHB
Environment=LD_LIBRARY_PATH=/home/fastchip/llama.cpp-vbbb-b7d4d85-sm75/bin:/home/fastchip/llama.cpp-vbbb-b7d4d85-sm75/lib:/usr/local/cuda-12.8/lib64
ExecStart=/home/fastchip/llama.cpp-vbbb-b7d4d85-sm75/bin/llama-server --model /mnt/usbsata/models/Qwen3.8-27B-UD-Q4_K_XL.gguf --alias Qwen3.8-27B --mmproj /mnt/usbsata/models/mmproj-Qwen3.8-27B-Q8_0.gguf --mmproj-offload --host 0.0.0.0 --port 8081 --parallel 5 --ctx-size 327680 --kv-unified --kv-unified-per-slot 65536 --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0.0 --repeat-penalty 1.0 --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0 --cache-ram 16384 --gpu-layers 99 --split-mode tensor --tensor-split 1,1,1 --reasoning-effort low --cache-disk /mnt/usbsata/models/kvcache --cache-disk-max 102400 --spec-type none --spec-draft-n-max 7 --model-draft /mnt/usbsata/models/Qwen3.8-27B-DFlash2-Q4_K_M.gguf -t 6 -tb 6 -b 2048 -ub 512 --api-key-file /etc/llama-server.api-key
Restart=always
RestartSec=5
TimeoutStopSec=20
SendSIGKILL=yes
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
